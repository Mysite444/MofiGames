# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Vercel Blob (required) — file storage for game thumbnails, game media
# (cover/trailer/preview/loading-screen), uploaded game builds, blog/page
# content images, and the Media Library. Supabase above still holds all
# of the actual data (games, posts, etc.) — this is only where the admin
# panel's file *uploads* end up.
#
# In Vercel: Project → Storage → Create Database → Blob, then connect it
# to this project — BLOB_READ_WRITE_TOKEN is injected automatically for
# every deployment, nothing to copy by hand. Running locally, pull it
# with `vercel env pull .env.local`, or copy it from Vercel Dashboard →
# Storage → your Blob store → .env.local tab.
BLOB_READ_WRITE_TOKEN=
#
# NEXT_PUBLIC_BLOB_BASE_URL is the same store's public base URL — looks
# like https://<store-id>.public.blob.vercel-storage.com — shown right
# next to the token on that same .env.local tab. Unlike the token, this
# one isn't injected automatically, so it needs to be set explicitly
# both here and in Vercel's Project → Settings → Environment Variables.
# It's what turns an uploaded game build's stored path back into a
# playable URL (see resolvePlayUrl in src/lib/games-mapping.ts) — the
# same role NEXT_PUBLIC_SUPABASE_URL used to play for that one purpose,
# now split out since blob files live on a different host than Supabase.
NEXT_PUBLIC_BLOB_BASE_URL=

# Admin → User Management → Login & Session Management. Optional: unlocks
# last-sign-in time, email-confirmation status, and force-logout for any
# account. Server-only — never prefix with NEXT_PUBLIC_, never expose to
# the browser. Find it in Supabase Dashboard → Project Settings → API →
# service_role key. Without it, everything else in User Management still
# works; that one screen just explains what's missing.
SUPABASE_SERVICE_ROLE_KEY=

# Advanced SEO Module — canonical URLs, sitemaps, and OG/Twitter tags are
# all built from this. Set to your real production domain, no trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.mofigames.com

# Admin → Automation. Optional, needed for scheduled jobs (including
# Scheduled Backups) to actually run on a timer rather than only via
# "Run now" in the admin UI. Set this to a random secret, then point an
# external scheduler (Vercel Cron, cron-job.org, GitHub Actions, etc.) at
# GET /api/cron/automation with `Authorization: Bearer <this value>`,
# once a minute. Also needs SUPABASE_SERVICE_ROLE_KEY above.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Admin → Security → Backups. Optional: when set, backup files written
# to the automation-backups bucket are encrypted (AES-256-GCM) before
# upload rather than stored as plain JSON. Any string works — it's
# hashed into a proper key, not used directly. Losing this key makes
# every encrypted backup taken under it unrecoverable, so store it
# somewhere durable, separate from the Supabase project itself.
# Generate with: openssl rand -hex 32
BACKUP_ENCRYPTION_KEY=

# Advanced SEO Module — AI SEO Assistant (Admin → any content form →
# "Generate with AI"). Optional: the rest of the SEO module works fine
# without it, the AI-assist buttons just return a clear error until this
# is set.
ANTHROPIC_API_KEY=

# Admin → Cache → PHP OPcache. Optional: only needed when you have a
# self-hosted PHP layer whose OPcache you want to monitor/reset from
# the admin panel. Leave all three blank for a pure Next.js / Vercel
# deployment with no PHP backend.
#   OPCACHE_STATUS_URL    — full URL of your opcache-status.php endpoint
#                           e.g. https://php.example.com/opcache-status.php
#   OPCACHE_RESET_URL     — full URL of your opcache-reset.php endpoint
#   OPCACHE_SECRET_HEADER — shared secret sent as X-OPcache-Secret on
#                           every request so your PHP script can reject
#                           unknown callers. Use a long random string.
#                           Generate with: openssl rand -hex 32
OPCACHE_STATUS_URL=
OPCACHE_RESET_URL=
OPCACHE_SECRET_HEADER=

# Admin → Cache → File Cache. Optional: overrides the default on-disk
# cache directory. Defaults to /tmp/mofigames-cache when unset.
# Note: on Vercel, /tmp is ephemeral and per-instance — file caching
# there is suitable for metrics/inspection only, not a shared cache.
FILE_CACHE_DIR=
